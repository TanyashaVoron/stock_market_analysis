      "source": [
        "\n",
        "company = [\n",
        "    {\n",
        "        'name': 'Сбербанк',\n",
        "        'tisket_full': 'sberbank_rts',\n",
        "        'tisket': 'SBER'\n",
        "    },\n",
        "    {\n",
        "        'name': 'ВК',\n",
        "        'tisket_full': 'mail.ru-grp-wi',\n",
        "        'tisket': 'VKCO'\n",
        "    },\n",
        "    {\n",
        "        'name': 'Тбанк',\n",
        "        'tisket_full': 'tcs-group-holding-plc',\n",
        "        'tisket': 'T'\n",
        "    },\n",
        "    {\n",
        "        'name':'OZON',\n",
        "        'tisket_full': 'ozon-holdings-plc',\n",
        "        'tisket': 'OZON'\n",
        "    },\n",
        "    {\n",
        "        'name':'МТС',\n",
        "        'tisket_full': 'mts_rts',\n",
        "        'tisket': 'MTSS'\n",
        "    }\n",
        "]\n",
        "\n",
        "len_data = 100\n",
        "prognoz = 5\n",
        "\n",
        "for comp in company:\n",
        "  name_company = comp['name']\n",
        "  tisket_full = comp['tisket_full']\n",
        "  tisket = comp['tisket']\n",
        "\n",
        "  word_gen = WordGenerator(f\"report_{name_company}.docx\")\n",
        "\n",
        "  df_combined = get_dataset_fundomental(name_company, tisket, tisket_full)\n",
        "\n",
        "  word_gen.add_title(f\"Фундаментальный анализ {name_company}\")\n",
        "\n",
        "  name = 'Net Income Margin %'\n",
        "  word_gen.add_title_2(f\"1. {name} (Чистая рентабельность)\")\n",
        "  word_gen.add_text('Доля чистой прибыли в выручке. Чем выше, тем эффективнее компания превращает выручку в прибыль. Стабильный уровень выше 20% — очень хороший сигнал, особенно в IT/финансовом секторе. Снижение до однозначных значений (<10%) — тревожный знак.')\n",
        "  years, values = df_combined.loc[name].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  word_gen.add_indicator_plot(years, values, name, top_line=20, bot_line=10)\n",
        "  word_gen.add_indicator_table({\n",
        "              \"год\": years,\n",
        "              \"Net Income Margin\": [f\"{float(x):.1f}%\" for x in values]\n",
        "            })\n",
        "\n",
        "  name = 'Levered Free Cash Flow'\n",
        "  word_gen.add_title_2(f\"2. Free Cash Flow ({name})\")\n",
        "  word_gen.add_text('Свободные денежные потоки после выплаты процентов — то, что реально остаётся компании. Постоянно отрицательный LFCF — красный флаг, даже при хорошей прибыли, особенно если это продолжается несколько лет подряд.')\n",
        "  years, values = df_combined.loc[name].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  word_gen.add_indicator_plot(years, values, name, top_line=0, bot_line=0)\n",
        "  word_gen.add_indicator_table({\n",
        "              \"год\": years,\n",
        "              f\"{name}\": values\n",
        "            })\n",
        "\n",
        "  word_gen.add_title_2(f\"3. Debt-to-Equity Ratio = Total Current Liabilities / Total Equity\")\n",
        "  word_gen.add_text('Соотношение обязательств к собственному капиталу. Значение выше 2–3 — сигнал о высоком финансовом рычаге. При D/E > 5 — нужно быть крайне осторожным.')\n",
        "  df_combined.loc['Debt-to-Equity Ratio'] = df_combined.loc['Total Current Liabilities'].astype(float) / df_combined.loc['Total Equity'].astype(float)\n",
        "  years, values_1 = df_combined.loc['Total Current Liabilities'].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  years, values_2 = df_combined.loc['Total Equity'].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  years, values = df_combined.loc['Debt-to-Equity Ratio'].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  word_gen.add_indicator_plot(years, values, \"Debt-to-Equity Ratio\", top_line=5, top_line_color='red', bot_line=2, bot_line_color='green')\n",
        "  word_gen.add_indicator_table({\n",
        "              \"год\": years,\n",
        "              \"Total Current Liabilities\": values_1,\n",
        "              \"Total Equity\": values_2,\n",
        "              \"Debt-to-Equity Ratio\": values,\n",
        "            })\n",
        "\n",
        "  name = 'Net Income Growth'\n",
        "  word_gen.add_title_2(f\"4. Net Income (Рост чистой прибыли) %\")\n",
        "  word_gen.add_text('Динамика прибыли — важна стабильность роста. Если присутствуют резкие падения и взлёты — тревожный сигнал.')\n",
        "  years, values = df_combined.loc[name].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  word_gen.add_indicator_plot(years, values, name, top_line=0, bot_line=0)\n",
        "  word_gen.add_indicator_table({\n",
        "              \"год\": years,\n",
        "              \"Net Income\": [f\"{float(x):.1f}%\" for x in values]\n",
        "            })\n",
        "\n",
        "  word_gen.add_title_2(f\"5. Operating Income Margin % = Operating Income / Total Revenues \")\n",
        "  word_gen.add_text('Эффективность компании в управлении операционной деятельностью. Хороший уровень — выше 20%. Резкое снижение — риск.')\n",
        "  df_combined.loc['Operating Income Margin'] = df_combined.loc['Operating Income'].astype(float) / df_combined.loc['Total Revenues'].astype(float) * 100\n",
        "  years, values_1 = df_combined.loc['Operating Income'].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  years, values_2 = df_combined.loc['Total Revenues'].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  years, values = df_combined.loc['Operating Income Margin'].dropna().pipe(lambda x: (x.index.tolist(), x.values.tolist()))\n",
        "  word_gen.add_indicator_plot(years, values, \"Operating Income Margin\", top_line=20, bot_line=20)\n",
        "  word_gen.add_indicator_table({\n",
        "              \"год\": years,\n",
        "              \"Operating Income\": values_1,\n",
        "              \"Total Revenues\": values_2,\n",
        "              \"Operating Income Margin\": [f\"{x:.1f}%\" for x in values],\n",
        "            })\n",
        "\n",
