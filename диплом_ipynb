        "class WordGenerator:\n",
        "    def __init__(self, filename):\n",
        "        \"\"\"\n",
        "        Инициализация объекта для создания Word-документа.\n",
        "        :param filename: Имя файла Word (.docx).\n",
        "        \"\"\"\n",
        "        self.filename = filename\n",
        "        self.doc = Document()\n",
        "\n",
        "        section = self.doc.sections[0]\n",
        "        section.left_margin = Inches(3 / 2.54)  # 3 см → ~1.18 дюйма\n",
        "        section.right_margin = Inches(2 / 2.54)\n",
        "        section.top_margin = Inches(2 / 2.54)\n",
        "        section.bottom_margin = Inches(2 / 2.54)\n",
        "\n",
        "    def add_page_break(self):\n",
        "        \"\"\"\n",
        "        Добавляет разрыв страницы в документ Word.\n",
        "        \"\"\"\n",
        "        self.doc.add_page_break()\n",
        "\n",
        "    def add_title(self, title):\n",
        "        \"\"\"\n",
        "        Добавление заголовка в Word.\n",
        "        :param title: Текст заголовка.\n",
        "        \"\"\"\n",
        "        h = self.doc.add_heading(title, level=1)\n",
        "        h.alignment = 1\n",
        "\n",
        "    def add_title_2(self, title):\n",
        "        \"\"\"\n",
        "        Добавление заголовка в Word.\n",
        "        :param title: Текст заголовка.\n",
        "        \"\"\"\n",
        "        self.doc.add_heading(title, level=2)\n",
        "\n",
        "    def add_titl_3(self, title):\n",
        "        \"\"\"\n",
        "        Добавление заголовка в Word.\n",
        "        :param title: Текст заголовка.\n",
        "        \"\"\"\n",
        "        self.doc.add_heading(title, level=3)\n",
        "\n",
        "    def add_text(self, text):\n",
        "        \"\"\"\n",
        "        Добавление обычного текста в Word.\n",
        "        :param text: Текст для добавления.\n",
        "        \"\"\"\n",
        "        paragraph = self.doc.add_paragraph(text)\n",
        "        paragraph.alignment = 3  # 3 = WD_ALIGN_PARAGRAPH.JUSTIFY (по ширине)\n",
        "\n",
        "    def add_table(self, data):\n",
        "        \"\"\"\n",
        "        Добавление таблицы в Word.\n",
        "        :param data: Словарь с одномерными массивами данных (списки или numpy.ndarray).\n",
        "        \"\"\"\n",
        "        # Определяем максимальную длину массивов\n",
        "        max_length = max(len(values) for values in data.values())\n",
        "\n",
        "        # Добавляем массив номеров от 1 до max_length (преобразуем в int)\n",
        "        data = {\"Номер\": list(range(1, max_length + 1)), **data}\n",
        "\n",
        "        # Уровняем длины всех массивов, дополняя короткие None\n",
        "        padded_data = {key: values + [None] * (max_length - len(values)) for key, values in data.items()}\n",
        "\n",
        "        # Создаем DataFrame из дополненного словаря\n",
        "        df = pd.DataFrame(padded_data)\n",
        "\n",
        "        # Транспонируем DataFrame (ключи становятся строками, значения — столбцами)\n",
        "        df = df.T\n",
        "\n",
        "        # Преобразуем DataFrame в список списков\n",
        "        table_data = df.values.tolist()\n",
        "\n",
        "        # Создаем таблицу в Word с дополнительным столбцом для названий строк\n",
        "        table = self.doc.add_table(rows=len(table_data), cols=len(table_data[0]) + 1)\n",
        "        table.style = \"Table Grid\"\n",
        "\n",
        "        # Заполняем таблицу данными\n",
        "        for i, row_data in enumerate(table_data):\n",
        "            row_cells = table.rows[i].cells\n",
        "            # Заполняем первый столбец названиями строк (ключами словаря)\n",
        "            row_cells[0].text = list(data.keys())[i]\n",
        "            # Заполняем остальные ячейки данными\n",
        "            for j, item in enumerate(row_data):\n",
        "                if i == 0:  # Только для первого столбца (номера)\n",
        "                    text = str(int(item)) if isinstance(item, (int, float)) else str(item) if item is not None else \"\"\n",
        "                else:  # Для остальных ячеек\n",
        "                    if isinstance(item, float):  # Форматируем float с тремя знаками после запятой\n",
        "                        text = f\"{item:.3f}\"\n",
        "                    else:\n",
        "                        text = str(item) if item is not None else \"\"\n",
        "                row_cells[j + 1].text = text\n",
        "\n",
        "        # Устанавливаем ширину таблицы по ширине страницы\n",
        "        for i, column in enumerate(table.columns):\n",
        "            if i == 0:\n",
        "                column.width = Inches(1.5)\n",
        "            else:\n",
        "                column.width = Inches(1)\n",
        "\n",
        "        # Устанавливаем выравнивание таблицы по ширине\n",
        "        table.alignment = 1  # 1 = WD_TABLE_ALIGNMENT.CENTER (по центру)\n",
