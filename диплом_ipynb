        "\n",
        "def format_float(x):\n",
        "    if isinstance(x, (int, float)) and not pd.isna(x):\n",
        "        if x == int(x):  # Целое число\n",
        "            return f\"{x:.0f}\"\n",
        "        else:\n",
        "            formatted = f\"{x:.2f}\"\n",
        "            formatted = re.sub(r\"(\\.\\d*?)0+$\", r\"\\1\", formatted)\n",
        "            formatted = re.sub(r\"\\.$\", \"\", formatted)  # Убираем точку без чисел\n",
        "            return formatted\n",
        "    return x\n",
        "\n",
        "def get_dataset_income_statement(name_company, tisket_full=\"sberbank_rts\"):\n",
        "    input_file = f\"{name_company}_{tisket_full}_income-statement.html\"\n",
        "    pattern = r'incomeStatementDataAnnual.*incomeStatementDataQuarterly'\n",
        "\n",
        "    try:\n",
        "        with open(input_file, \"r\", encoding=\"utf-8\") as f:\n",
        "            content = f.read()\n",
        "\n",
        "        match = re.search(pattern, content, re.DOTALL)\n",
        "\n",
        "        if match:\n",
        "            r = match.group(0)\n",
        "            r = r[27:-30]\n",
        "            data = json.loads(r)\n",
        "\n",
        "            reports = data.get(\"reports\", [])\n",
        "            result = {}\n",
        "\n",
        "            for report in reports:\n",
        "                year = report.get(\"year\")\n",
        "                indicators = report.get(\"indicators\", {})\n",
        "\n",
        "                if year not in result:\n",
        "                    result[year] = {\"дата\": year}\n",
        "\n",
        "                for key, value_data in indicators.items():\n",
        "                    indicator_name = value_data.get(\"name\")\n",
        "                    value = value_data.get(\"value\")\n",
        "\n",
        "                    try:\n",
        "                        numeric_value = float(value)\n",
        "                    except (TypeError, ValueError):\n",
        "                        numeric_value = value\n",
        "\n",
        "                    result[year][indicator_name] = numeric_value\n",
        "\n",
        "            df = pd.DataFrame(result.values()).set_index(\"дата\").sort_index()\n",
        "            df_transposed = df.T\n",
        "\n",
        "            df_transposed_formatted = df_transposed.applymap(format_float)\n",
        "            return df_transposed_formatted, input_file\n",
        "\n",
        "        else:\n",
        "            print(\"Совпадение не найдено.\")\n",
        "\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Файл '{input_file}' не найден.\")\n",
        "    except json.JSONDecodeError as e:\n",
        "        print(f\"Ошибка парсинга JSON: {e}\")\n",
        "    except Exception as e:\n",
        "        print(f\"Произошла ошибка: {e}\")\n",
        "\n",
